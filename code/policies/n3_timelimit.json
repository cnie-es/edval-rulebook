{
    "@context": "http://www.w3.org/ns/odrl.jsonld",
    "@type": "Policy",
    "uid": "http://nel-dataspace.es/policy/n3-timelimit",
    "profile": "http://www.w3.org/ns/odrl/2/profile/idsc",
    "permission": [
        {
            "target": "http://nel-dataspace.es/asset/{ASSET_ID}",
            "action": "use",
            "duty": [
                {
                    "action": "delete",
                    "constraint": [
                        {
                            "leftOperand": "elapsedTime",
                            "operator": "gt",
                            "rightOperand": "P30D"
                        }
                    ]
                }
            ]
        }
    ]
}